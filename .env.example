# ===========================================
# Docker Compose (local hoặc VPS)
# Copy thành .env và sửa theo môi trường.
# ===========================================

# --- Build frontend (bắt buộc khi chạy sau nginx) ---
# Local (docker compose): dùng http://localhost — mở app tại http://localhost để API + WebSocket cùng qua nginx, chat mới thấy tin nhắn nhau.
# VPS: dùng URL công khai (http/https), không port.
# Để trống thì FE fallback localhost:3002 (chat có thể lỗi khi chạy Docker vì 2 tab không cùng backend).
# Không thêm dấu ; hoặc khoảng trắng thừa — code đã tự trim.
REACT_APP_API_URL=http://localhost

# --- Backend CORS (cho BE) ---
# Local: http://localhost:3003 hoặc http://localhost
# VPS: https://social-demo.maxnoah.io.vn hoặc http://165.22.99.117
CORS_ORIGIN=http://localhost
