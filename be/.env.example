# Copy thành .env hoặc .env.local và điền giá trị.
# Load theo NODE_ENV: .env → .env.development | .env.production → .env.local

PORT=3002
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=social_demo
CORS_ORIGIN=http://localhost:3003

