# Production: NODE_ENV=production (khi chạy BE local: npm run start trong be/)
# Khi deploy bằng Docker: env lấy từ ROOT .env.production, không đọc file này → không cần lưu DB trùng.
# Chỉ cần set bên dưới khi chạy BE trên máy (không Docker); có thể dùng be/.env.local thay.
PORT=3002
CORS_ORIGIN=https://social-demo.maxnoah.io.vn
