# --- Build frontend (bắt buộc khi chạy sau nginx) ---
# Local (docker compose trên máy mình): dùng http://localhost
# VPS (deploy server): dùng URL công khai (http hoặc https), không port.
# Nếu để trống, FE build sẽ fallback localhost:3002 (sai khi deploy VPS).
REACT_APP_API_URL=http://localhost

# --- Backend CORS (cho BE) ---
# Local: http://localhost:3003 hoặc http://localhost
# VPS: https://social-demo.maxnoah.io.vn hoặc http://165.22.99.117
CORS_ORIGIN=http://localhost
